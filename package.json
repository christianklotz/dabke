{
  "name": "dabke",
  "version": "0.84.0",
  "description": "Scheduling library powered by constraint programming (CP-SAT)",
  "keywords": [
    "constraint-programming",
    "cp-sat",
    "operations-research",
    "optimization",
    "or-tools",
    "scheduling",
    "staff-scheduling",
    "workforce-management"
  ],
  "homepage": "https://github.com/christianklotz/dabke#readme",
  "bugs": {
    "url": "https://github.com/christianklotz/dabke/issues"
  },
  "license": "MIT",
  "author": "Christian Klotz <hello@christianklotz.co.uk>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christianklotz/dabke.git"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "LICENSE",
    "README.md",
    "solver",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "npm run typecheck && npm run test:unit",
    "test:unit": "vitest run --project=unit",
    "test:unit:watch": "vitest --watch --project=unit",
    "test:integration": "vitest run --project=integration",
    "test:integration:watch": "vitest --watch --project=integration"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "commander": "^15.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20"
  }
}
